{
  "manifest_version": 3,
  "name": "Minimal New Tab",
  "version": "2.1.0",
  "description": "Nueva pestaña con el diseño de Google y hasta 100 accesos directos.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Añadir a Nueva pestaña",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "commands": {
    "add-shortcut": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Añadir la página actual a Nueva pestaña"
    }
  },
  "host_permissions": [
    "https://speed.cloudflare.com/*"
  ],
  "permissions": [
    "activeTab",
    "bookmarks",
    "contextMenus",
    "geolocation",
    "storage"
  ]
}
